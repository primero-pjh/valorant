{
  "name": "valorant-auction",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  // public/index.html(경매 페이지)을 / 에서 서빙. 파일에 없는 경로(/rooms...)는 src/index.js로 간다
  "assets": { "directory": "./public" },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "AuctionRoom" }]
  },
  // 무료 플랜은 SQLite 기반 Durable Object만 쓸 수 있다
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AuctionRoom"] }]
}
